{
  "name": "touch-grass",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "zod": "^4.5.4",
      "typescript": "^6.0.3",
      "@types/bun": "^1.4.2",
      "varlock": "1.18.0",
      "@trpc/server": "^11.18.0",
      "better-auth": "1.7.5",
      "lucide-react": "^1.41.0",
      "react": "^19.2.8",
      "react-dom": "^19.2.8",
      "tailwindcss": "^4.3.3",
      "@trpc/client": "^11.18.0",
      "@types/react": "^19.2.18",
      "@types/react-dom": "^19.2.7",
      "drizzle-orm": "1.0.0-rc.4"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "check-types": "turbo run check-types",
    "dev:web": "turbo run dev -F web --",
    "dev:server": "turbo run dev -F server --",
    "db:push": "turbo run db:push -F @touch-grass/db --",
    "db:studio": "turbo run db:studio -F @touch-grass/db --",
    "db:generate": "turbo run db:generate -F @touch-grass/db --",
    "db:migrate": "turbo run db:migrate -F @touch-grass/db --",
    "env:generate": "varlock codegen --path ./apps/web/ && varlock codegen --path ./apps/server/ && varlock codegen --path ./packages/db/",
    "postinstall": "varlock codegen --path ./apps/web/ && varlock codegen --path ./apps/server/ && varlock codegen --path ./packages/db/",
    "auth:generate": "cd apps/server && bun run auth:generate",
    "test": "bun run --cwd apps/web test && bun run --cwd apps/server test",
    "start": "turbo run start"
  },
  "dependencies": {
    "zod": "catalog:"
  },
  "devDependencies": {
    "@touch-grass/config": "workspace:*",
    "@types/bun": "catalog:",
    "railway": "3.12.0",
    "turbo": "^2.10.12",
    "typescript": "catalog:",
    "varlock": "catalog:"
  },
  "packageManager": "bun@1.4.0"
}
